        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score\n",
        "from mpl_toolkits.mplot3d import Axes3D\n",
        "\n",
        "# =========================\n",
        "# Load dataset\n",
        "# =========================\n",
        "data = pd.read_csv(\"/content/homework.csv\")\n",
        "\n",
        "# =========================\n",
        "#  SIMPLE LINEAR REGRESSION\n",
        "# X = lotsize, Y = price\n",
        "# =========================\n",
        "X_simple = data[['lotsize']]\n",
        "y = data['price']\n",
        "\n",
        "model_simple = LinearRegression()\n",
        "model_simple.fit(X_simple, y)\n",
        "\n",
        "y_pred_simple = model_simple.predict(X_simple)\n",
        "\n",
        "# ---- Metrics Simple LR ----\n",
        "mae_simple = mean_absolute_error(y, y_pred_simple)\n",
        "mse_simple = mean_squared_error(y, y_pred_simple)\n",
        "rmse_simple = np.sqrt(mse_simple)\n",
        "r2_simple = r2_score(y, y_pred_simple)\n",
        "\n",
        "print(\"=== Simple Linear Regression Metrics ===\")\n",
        "print(\"MAE:\", mae_simple)\n",
        "print(\"MSE:\", mse_simple)\n",
        "print(\"RMSE:\", rmse_simple)\n",
        "print(\"R2:\", r2_simple)\n",
        "\n",
        "# ---- Visualization Simple LR ----\n",
        "plt.scatter(X_simple, y)\n",
        "plt.plot(X_simple, y_pred_simple)\n",
        "plt.xlabel(\"Lot Size\")\n",
        "plt.ylabel(\"Price\")\n",
        "plt.title(\"Simple Linear Regression\")\n",
        "plt.show()\n",
        "\n",
        "\n",
        "# =========================\n",
        "#  MULTIPLE LINEAR REGRESSION\n",
        "# =========================\n",
        "X_multi = data[['lotsize', 'bedrooms', 'bathrms']]  # adapte si besoin\n",
        "\n",
        "model_multi = LinearRegression()\n",
        "model_multi.fit(X_multi, y)\n",
        "\n",
        "y_pred_multi = model_multi.predict(X_multi)\n",
        "\n",
        "# ---- Metrics Multiple LR ----\n",
        "mae_multi = mean_absolute_error(y, y_pred_multi)\n",
        "mse_multi = mean_squared_error(y, y_pred_multi)\n",
        "rmse_multi = np.sqrt(mse_multi)\n",
        "r2_multi = r2_score(y, y_pred_multi)\n",
        "\n",
        "print(\"\\n=== Multiple Linear Regression Metrics ===\")\n",
        "print(\"MAE:\", mae_multi)\n",
        "print(\"MSE:\", mse_multi)\n",
        "print(\"RMSE:\", rmse_multi)\n",
        "print(\"R2:\", r2_multi)\n",
        "\n",
        "# =========================\n",
        "#  Visualization Multiple LR (3D)\n",
        "# lotsize + bedrooms → price\n",
        "# =========================\n",
        "X_vis = data[['lotsize', 'bedrooms']]\n",
        "model_vis = LinearRegression()\n",
        "model_vis.fit(X_vis, y)\n",
        "\n",
        "x1 = np.linspace(data['lotsize'].min(), data['lotsize'].max(), 20)\n",
        "x2 = np.linspace(data['bedrooms'].min(), data['bedrooms'].max(), 20)\n",
        "x1, x2 = np.meshgrid(x1, x2)\n",
        "\n",
        "y_plane = model_vis.intercept_ + model_vis.coef_[0]*x1 + model_vis.coef_[1]*x2\n",
        "\n",
        "fig = plt.figure()\n",
        "ax = fig.add_subplot(111, projection='3d')\n",
        "\n",
        "ax.scatter(data['lotsize'], data['bedrooms'], y)\n",
        "ax.plot_surface(x1, x2, y_plane, alpha=0.5)\n",
        "\n",
        "ax.set_xlabel(\"Lot Size\")\n",
        "ax.set_ylabel(\"Bedrooms\")\n",
        "ax.set_zlabel(\"Price\")\n",
        "ax.set_title(\"Multiple Linear Regression (3D)\")\n",
        "\n",
        "plt.show()\n"
      ],
